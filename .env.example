# Optional LLM event analysis and non-English normalization.
# Rule-based mode works without an OpenAI API key.
OPENAI_API_KEY=
USE_LLM_EVENT_ANALYST=false
LLM_EVENT_ANALYST_MODEL=gpt-4.1-mini

# Local app wiring.
GEORISK_API_URL=http://127.0.0.1:8000
GEORISK_API_TIMEOUT_SECONDS=120

# Set true for fully offline environments where the embedding model is already cached.
GEORISK_LOCAL_MODEL_FILES_ONLY=false
